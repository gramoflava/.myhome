#!/usr/bin/env python3
"""Compile selected Markdown files into Markdown, EPUB, and DOCX."""

from __future__ import annotations

import argparse
import re
import shutil
import subprocess
import sys
import tempfile
from pathlib import Path


CHAPTER_NUMBER = re.compile(r"^(\d+)\s+-\s+.+\.md$", re.IGNORECASE)
PANDOC_FORMATS = {"epub", "docx"}


def selected_chapters(inputs: list[Path]) -> tuple[Path, list[Path]]:
    chapters: list[Path] = []
    for raw_path in inputs:
        path = raw_path.expanduser().resolve()
        if path.is_dir():
            chapters.extend(item for item in path.iterdir() if item.is_file() and item.suffix.casefold() == ".md")
        elif path.is_file() and path.suffix.casefold() == ".md":
            chapters.append(path)
        elif path.is_file():
            raise ValueError(f"not a Markdown file: {path}")
        else:
            raise ValueError(f"path not found: {path}")
    chapters = list(dict.fromkeys(chapters))
    if not chapters:
        raise ValueError("no Markdown files selected")
    parents = {path.parent for path in chapters}
    if len(parents) != 1:
        raise ValueError("all selected chapters must be from the same folder")
    def sort_key(path: Path) -> tuple[int, int, str]:
        numbered = CHAPTER_NUMBER.match(path.name)
        return (0, int(numbered.group(1)), path.name.casefold()) if numbered else (1, 0, path.name.casefold())

    chapters.sort(key=sort_key)
    return chapters[0].parent, chapters


def combined_markdown(chapters: list[Path], title: str | None = None) -> str:
    contents = [path.read_text(encoding="utf-8").strip() for path in chapters]
    prefix = f"# {title}\n\n" if title else ""
    return prefix + "\n\n".join(contents) + "\n"


def write_atomic(path: Path, content: str) -> None:
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=path.parent, delete=False) as handle:
        handle.write(content)
        temporary = Path(handle.name)
    temporary.replace(path)


def run_pandoc(
    pandoc: str,
    manuscript: Path,
    destination: Path,
    source: Path,
    title: str,
    author: str | None,
    language: str,
) -> None:
    with tempfile.NamedTemporaryFile(dir=destination.parent, suffix=destination.suffix, delete=False) as handle:
        temporary = Path(handle.name)
    stylesheet: Path | None = None
    try:
        command = [
            pandoc,
            str(manuscript),
            "--from=gfm",
            "--standalone",
            f"--resource-path={source}",
            "--metadata",
            f"title={title}",
            "--metadata",
            f"lang={language}",
            "--output",
            str(temporary),
        ]
        if destination.suffix == ".epub":
            # EPUB readers already expose the navigation document as their
            # table of contents. Keep it and the generated title page out of
            # the reading spine. Pandoc's otherwise useful default EPUB CSS
            # also forces a page break before every H1; at the beginning of a
            # new spine item that creates a genuinely blank first page, so
            # preserve the defaults and append one narrow override.
            css_result = subprocess.run(
                [pandoc, "--print-default-data-file=epub.css"],
                text=True,
                capture_output=True,
            )
            if css_result.returncode:
                detail = css_result.stderr.strip() or "could not read Pandoc's default EPUB stylesheet"
                raise RuntimeError(detail)
            with tempfile.NamedTemporaryFile(
                "w", encoding="utf-8", dir=destination.parent, suffix=".css", delete=False
            ) as css_handle:
                css_handle.write(css_result.stdout)
                css_handle.write(
                    "\n/* A spine item already starts on a new page. */\n"
                    "section.level1 > h1:first-child {\n"
                    "  page-break-before: auto;\n"
                    "  break-before: auto;\n"
                    "}\n"
                )
                stylesheet = Path(css_handle.name)
            command[2:2] = [
                "--epub-title-page=false",
                "--split-level=1",
                f"--css={stylesheet}",
            ]
        elif destination.suffix == ".docx":
            command[2:2] = ["--toc"]
        if author:
            command[command.index("--output"):command.index("--output")] = ["--metadata", f"author={author}"]
        result = subprocess.run(command, cwd=source, text=True, capture_output=True)
        if result.returncode:
            detail = result.stderr.strip() or result.stdout.strip() or f"exit status {result.returncode}"
            raise RuntimeError(f"Pandoc could not create {destination.suffix}: {detail}")
        temporary.replace(destination)
    finally:
        temporary.unlink(missing_ok=True)
        if stylesheet:
            stylesheet.unlink(missing_ok=True)


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Compile selected Markdown files into a complete book",
        epilog=(
            "Examples:\n"
            "  bookcompile '01 - Start.md' '02 - End.md'\n"
            "  bookcompile --author 'Author Name' /path/to/Book/\n"
            "  bookcompile --format epub --format docx /path/to/Book/\n\n"
            "Automator Quick Action (macOS):\n"
            "  1. Open Automator and create a new Quick Action.\n"
            "  2. Set 'Workflow receives current' to 'files or folders' in Finder.\n"
            "  3. Add a 'Run Shell Script' action.\n"
            "  4. Set Shell to /bin/zsh and 'Pass input' to 'as arguments'.\n"
            "  5. Use this script:\n\n"
            "     source \"$HOME/.zprofile\"\n"
            "     bookcompile --format epub \"$@\"\n\n"
            "     To embed author metadata, use:\n"
            "     bookcompile --format epub --author \"Author Name\" \"$@\"\n\n"
            "Numbered chapters are sorted numerically; other files are sorted by name. "
            "Outputs go into the selected files' Exports folder."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "chapters",
        type=Path,
        nargs="+",
        help="selected Markdown files, or one folder containing them",
    )
    parser.add_argument("--title", help="book title (default: source folder name)")
    parser.add_argument("--author", help="author stored in EPUB/DOCX metadata")
    parser.add_argument("--language", default="en", help="BCP 47 language tag (default: en)")
    parser.add_argument("--output-dir", type=Path, help="destination folder (default: CHAPTER_FOLDER/Exports)")
    parser.add_argument(
        "--format",
        dest="formats",
        action="append",
        choices=("md", "epub", "docx"),
        help="output format; repeat for several (default: all three)",
    )
    return parser.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = parse_args(argv)
    try:
        source, chapters = selected_chapters(args.chapters)
    except (OSError, ValueError) as error:
        print(f"bookcompile: {error}", file=sys.stderr)
        return 2

    formats = list(dict.fromkeys(args.formats or ["md", "epub", "docx"]))
    pandoc = shutil.which("pandoc")
    if PANDOC_FORMATS.intersection(formats) and not pandoc:
        print(
            "bookcompile: Pandoc is required for EPUB/DOCX; run ~/.myhome/manage.sh --init "
            "or request only --format md",
            file=sys.stderr,
        )
        return 2

    output_name = chapters[0].stem if len(chapters) == 1 else source.name
    title = args.title or output_name
    output_dir = (args.output_dir.expanduser().resolve() if args.output_dir else source / "Exports")
    output_dir.mkdir(parents=True, exist_ok=True)
    manuscript = output_dir / f"{output_name}.md"

    created: list[Path] = []
    if "md" in formats:
        # A visible Markdown master gets a book title for convenience. The
        # conversion input below does not: EPUB/DOCX receive title metadata,
        # and another H1 would become a duplicate, empty chapter.
        visible_title = title if len(chapters) > 1 else None
        write_atomic(manuscript, combined_markdown(chapters, visible_title))
        created.append(manuscript)
    with tempfile.NamedTemporaryFile("w", encoding="utf-8", dir=output_dir, suffix=".md", delete=False) as handle:
        handle.write(combined_markdown(chapters))
        conversion_manuscript = Path(handle.name)
    try:
        for output_format in ("epub", "docx"):
            if output_format not in formats:
                continue
            destination = output_dir / f"{output_name}.{output_format}"
            try:
                run_pandoc(pandoc, conversion_manuscript, destination, source, title, args.author, args.language)
            except RuntimeError as error:
                print(f"bookcompile: {error}", file=sys.stderr)
                return 1
            created.append(destination)
    finally:
        conversion_manuscript.unlink(missing_ok=True)
    for path in created:
        print(path)
    if sys.platform == "darwin" and shutil.which("osascript"):
        subprocess.run(
            [
                "osascript",
                "-e",
                'on run argv\ndisplay notification (item 2 of argv) with title (item 1 of argv)\nend run',
                "Book compiled",
                f"{len(chapters)} chapters → {', '.join(formats).upper()}",
            ],
            capture_output=True,
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
